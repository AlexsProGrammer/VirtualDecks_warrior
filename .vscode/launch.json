{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CMake: Debug App",
            "type": "cppvsdbg",
            "request": "launch",
            "projectRoot": "${workspaceFolder}",
            "program": "${command:cmake.launchTargetPath}", 
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "$PATH;${command:cmake.getLaunchTargetDirectory}"
                }
            ],
            "externalConsole": false
        }
    ]
}
